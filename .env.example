# Docker Compose configuration. For a local backend-only run, use backend/.env.example.
APP_NAME=Profit Forensics Engine
ENVIRONMENT=production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=sqlite:////data/profit_forensics.db
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=20
CONFIDENCE_THRESHOLD=0.7

# Optional Razorpay read-only ingestion. Request credentials can also be supplied
# transiently through the Connect Razorpay UI and are never persisted.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=15
