# Backend configuration (copy values into backend/.env for local backend-only runs)
APP_NAME=Profit Forensics Engine
ENVIRONMENT=production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=sqlite:///./profit_forensics.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
CONFIDENCE_THRESHOLD=0.7

# Optional Razorpay read-only ingestion. Request credentials can also be supplied
# transiently through the Connect Razorpay UI and are never persisted.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=15

# Frontend proxy target (copy into frontend/.env.local)
BACKEND_URL=http://127.0.0.1:8000
